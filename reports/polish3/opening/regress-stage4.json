  "lines": {
    "full": {
      "op_n1": {
        "text": "元弘三年五月。鎌倉に、火が上がった。",
        "color": "#eee9dc",
        "bar": "#05080a",
        "inBar": true,
        "at": 2.5
      },
      "op_n2": {
        "text": "およそ百五十年続いた幕府は、数日の攻防の末に滅んだ。",
        "color": "#eee9dc",
        "bar": "#05080a",
        "inBar": true,
        "at": 6.5
      },
      "op_n3": {
        "text": "東勝寺は焼け、北条一門は、そこで自害した。",
        "color": "#eee9dc",
        "bar": "#05080a",
        "inBar": true,
        "at": 12.77
      },
      "op_n4": {
        "text": "主を失った者たちは、散り散りに山へ向かった。",
        "color": "#f08a66",
        "bar": "#05080a",
        "inBar": true,
        "at": 21.97
      },
      "op_n5": {
        "text": "榊三郎景継も、その一人。あの夜のことを、誰にも語らなかった。",
        "color": "#f08a66",
        "bar": "#05080a",
        "inBar": true,
        "at": 31.5
      },
      "op_n6": {
        "text": "——その火は、まだ消えていなかった。",
        "color": "#f08a66",
        "bar": "#05080a",
        "inBar": true,
        "at": 38.53
      }
    }
  },
